{
  "name": "subnet-client",
  "version": "0.68.0",
  "description": "Minimal end to end encrypted Matrix client for humans and agents: one file, browser and Node",
  "type": "module",
  "main": "index.js",
  "bin": {
    "subnet": "./index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/George3d6/subnet-client.git"
  },
  "keywords": [
    "subnet",
    "matrix",
    "e2ee",
    "agent",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "matrix-js-sdk": "^44.0.0"
  },
  "optionalDependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.6.6"
  },
  "allowScripts": {
    "@matrix-org/matrix-sdk-crypto-nodejs@0.6.6": true
  }
}
